{
  "name": "noteflow2",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:win": "powershell -ExecutionPolicy Bypass -File ./scripts/android-shortpath.ps1",
    "android:setup-win": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-windows-android.ps1",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export -p web",
    "api": "npm run dev --prefix noteflow-api",
    "api:start": "npm run start --prefix noteflow-api",
    "db:test": "npm run db:test --prefix server",
    "db:migrate": "npm run db:migrate --prefix server",
    "postinstall": "patch-package && npm install --prefix noteflow-api --omit=dev"
  },
  "dependencies": {
    "@expo/metro-runtime": "~56.0.13",
    "@expo/vector-icons": "^15.0.2",
    "@neondatabase/serverless": "^1.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^24.1.0",
    "@react-native-firebase/auth": "^24.1.0",
    "@react-native-firebase/firestore": "^24.1.0",
    "@shopify/flash-list": "2.0.2",
    "expo": "~56.0.12",
    "expo-constants": "~56.0.16",
    "expo-dev-client": "~56.0.20",
    "expo-font": "~56.0.5",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.11",
    "expo-image-picker": "~56.0.18",
    "expo-linking": "~56.0.14",
    "expo-router": "~56.2.11",
    "expo-secure-store": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "^0.21.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "private": true
}
