# Copia este archivo a .env.local y rellena con tus valores reales.
# NUNCA subas secretos a .env.example ni al repositorio.

DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# App Expo — URL de la API
# Web local:        http://localhost:3000/api
# Emulador Android: http://10.0.2.2:3000/api
# Vercel (web):     https://TU-API.vercel.app/api
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# API Next.js — opcional en local (hay fallback), recomendado en Vercel
JWT_SECRET=

# AWS S3 — subida de imágenes (solo servidor / proyecto API en Vercel)
# Guía: docs/configuracion-aws-s3.md
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
AWS_S3_BUCKET=noteflow2-images
AWS_S3_PUBLIC_URL=https://noteflow2-images.s3.eu-north-1.amazonaws.com

# Firebase (móvil nativo)
FIREBASE_PROJECT_ID=noteflow2-18554
 