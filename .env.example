DATABASE_URL=

# App Expo — API URL
# Emulador Android: http://10.0.2.2:3000/api
# Móvil físico (misma WiFi): la app detecta la IP del PC automáticamente
# Web: http://localhost:3000/api
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api

# API Next.js (noteflow-api/) — también en Vercel
JWT_SECRET=

# AWS S3 — subida de imágenes (avatar y adjuntos)
# Solo en el servidor (noteflow-api/.env.local o variables en Vercel proyecto API)
# Guía paso a paso: docs/configuracion-aws-s3.md
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
AWS_S3_BUCKET=
# Opcional: https://TU-BUCKET.s3.eu-west-1.amazonaws.com
AWS_S3_PUBLIC_URL=
FIREBASE_PROJECT_ID=noteflow2-18554
