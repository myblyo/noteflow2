{
  "expo": {
    "name": "Noteflow2",
    "slug": "Noteflow2",
    "scheme": "noteflow2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.myblyo.noteflow2",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.myblyo.noteflow2"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-image-picker",
        {
          "photosPermission": "Noteflow necesita acceso a tus fotos para el perfil y adjuntos en notas.",
          "cameraPermission": "Noteflow necesita la cámara para tomar fotos de perfil o adjuntarlas a notas."
        }
      ],
      "expo-image"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5cf77b91-c0d7-4fe4-8074-4878958d8d62"
      }
    },
    "owner": "myblyo"
  }
}
